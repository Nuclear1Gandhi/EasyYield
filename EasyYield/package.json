{
  "name": "EasyYield",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "prepare": "husky",
    "preinstall:mongo": "node ./src/scripts/preinstall-mongo.js",
    "test": "vitest",
    "seed": "tsx ./src/scripts/seedYieldSources",
    "update": "tsx ./src/scripts/updateYieldSources",
    "find-dapps": "tsx --env-file=.env ./src/scripts/findDapps.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "6.1.0",
    "@sveltejs/kit": "2.30.1",
    "@sveltejs/vite-plugin-svelte": "6.1.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/svelte": "5.2.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "10.4.21",
    "cypress": "14.5.4",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.11.0",
    "flowbite": "^3.1.2",
    "husky": "9.1.7",
    "lint-staged": "16.1.5",
    "mongodb-memory-server": "^10.2.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "sass-embedded": "^1.90.0",
    "svelte": "5.38.1",
    "svelte-check": "4.3.1",
    "svelte-preprocess": "6.0.3",
    "tailwindcss": "4.1.12",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "tsx": "^4.20.4",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vite-plugin-svelte": "3.0.1",
    "vitest": "3.2.4"
  },
  "type": "module",
  "dependencies": {
    "@iconify/svelte": "^5.0.1",
    "@radixdlt/babylon-gateway-api-sdk": "1.10.1",
    "@radixdlt/radix-dapp-toolkit": "2.2.1",
    "@tanstack/svelte-query": "5.85.3",
    "bignumber.js": "^9.3.1",
    "chart.js": "4.5.0",
    "cookie": "^1.0.2",
    "dotenv": "17.2.1",
    "flowbite-svelte": "1.12.3",
    "jsonwebtoken": "^9.0.2",
    "ky": "1.8.2",
    "mongoose": "8.17.1",
    "supertest": "^7.1.4",
    "zod": "4.0.17"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "./.mongodb-binaries",
      "version": "6.0.2"
    }
  }
}
